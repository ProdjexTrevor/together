# Together — environment template

# MySQL (hosted)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Quote passwords that contain # or ?
# MYSQL_PASSWORD="your#password"
DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE"

USE_MYSQL=true

# Optional Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_SUPABASE=false
