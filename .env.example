# Together — environment template

# Supabase Postgres (preferred for Vercel)
USE_MYSQL=false
USE_SUPABASE=true

# Transaction pooler (6543) — app runtime. URL-encode special chars in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (5432) — migrations / prisma db push
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Required for private check-in notes (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/deadlines (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Intimate Basecamp passcode (server-only)
BASECAMP_PASSCODE=

# Supabase project metadata (optional client helpers)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Legacy MySQL (optional)
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# USE_MYSQL=true
# USE_SUPABASE=false
# DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE"
